ROOT_PATH = /path/to/this/repo/
MY_DATA_PATH = /path/to/user/processed/data/
RAW_DATA_PATH = /path/to/raw/data/
AGENT_DATA_PATH = /path/to/agent/processed/data/

# Required for agent/scripts/run_ca_data_repair_loop.py (local Cursor SDK agents).
# Create a user API key at https://cursor.com/dashboard/integrations
# CURSOR_API_KEY=cursor_...
# Optional model override (default: cursor-grok-4.5-high / Cursor Grok 4.5 High)
# CURSOR_MODEL=cursor-grok-4.5-high
